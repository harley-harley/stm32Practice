include @platforms/boards/nucleo_h753zi.repl
sysbus LoadELF @Projects/port/stm32Practice/initialCopyPaste/build/initialCopyPaste.elf
machine LoadPlatformDescriptionFromString "tmp103: Sensors.TMP103 @ i2c1 0x70"
machine LoadPlatformDescriptionFromString "mapped: Memory.MappedMemory { size: 0x00800000 }; mt25q: SPI.Micron_MT25Q @ spi4 { underlyingMemory: mapped }"

logLevel -1 gpioPortE.YellowLED
logLevel -1 spi4.mt25q
showAnalyzer sysbus.usart2

sysbus.i2c1.tmp103 Temperature 21.67
sysbus.adcM1S2.adcM1S2-channel10 Volts 2.2